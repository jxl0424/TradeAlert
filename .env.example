# Copy to .env and fill in. Never commit .env.

# REQUIRED for SEC EDGAR filings (dilution checks). SEC blocks requests without a
# descriptive User-Agent that includes a contact email. Use your own email here.
SEC_USER_AGENT="TradeAlert research tool you@example.com"

# OPTIONAL: AI summaries for the top candidates (Claude). Leave empty to disable.
ANTHROPIC_API_KEY=
TRADEALERT_AI_MODEL=claude-haiku-5-5
TRADEALERT_AI_TOP_N=10
TRADEALERT_AI_MAX_TOKENS=2000

# OPTIONAL: extra company news from Finnhub (free key at finnhub.io)
FINNHUB_API_KEY=

# OPTIONAL filters / tuning (defaults shown)
TRADEALERT_MIN_PRICE=0.10
TRADEALERT_MAX_PRICE=5.00
TRADEALERT_MIN_AVG_DOLLAR_VOLUME=100000
TRADEALERT_SHORTLIST_SIZE=40
TRADEALERT_HIT_THRESHOLD_PCT=20
# TRADEALERT_DATA_DIR=./data
# TRADEALERT_FRONTEND_DIR=./frontend
